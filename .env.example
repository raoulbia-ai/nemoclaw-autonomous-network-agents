# --- LLM endpoint (OpenAI-compatible) -------------------------------------
# The agents need an inference endpoint exposing the OpenAI chat-completions
# API. These variables are consumed by `nemoclaw onboard` (see README Quick
# Start). Standard OpenAI clients append `/v1/` to the base URL — make sure
# your endpoint serves the API under `/v1/chat/completions`.

NEMOCLAW_ENDPOINT_URL=https://api.openai.com
NEMOCLAW_MODEL=gpt-4o-mini
COMPATIBLE_API_KEY=sk-replace-me
NEMOCLAW_PROVIDER=custom

# Required if your endpoint is on a private/loopback address (e.g. a local
# proxy). Set to 1 to bypass nemoclaw's SSRF guard.
NEMOCLAW_ALLOW_PRIVATE_ENDPOINT=0

# --- OpenShell / sandbox names --------------------------------------------
OPENSHELL_GATEWAY=nemoclaw
LLM_SANDBOX=my-assistant
LLM_PROVIDER=compatible-endpoint
